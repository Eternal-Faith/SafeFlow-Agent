# Optional OpenAI-compatible API settings
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model overrides
SAFEFLOW_LLM_MODEL=gpt-4o-mini
SAFEFLOW_VISION_MODEL=gpt-4o-mini
SAFEFLOW_AUDIO_MODEL=gpt-4o-mini

# Optional local runtime paths
SAFEFLOW_DB_PATH=var/safeflow_runs.sqlite3
SAFEFLOW_CHROMA_DIR=var/chroma
